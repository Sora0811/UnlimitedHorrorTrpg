# 建置產物（跑腳本時產生的暫存對照表，可重新生成）
build/*.json

# 分段抽取的段檔（可由 extract_batch.py 重跑重建）
build/extract-parts/
build/extract-all.json

# Markdown 資源書（可由 export_md.py 重跑重建）
build/md/
build/md-sample/

# 例外：這是導航排序的依據，必須進版控
# 否則 clone 後 gen_nav_fs.py 找不到它，各分類會退回名稱排序
!build/original-order.json

# 例外：欄位詞典是抽取器的 schema 來源，維護者要能調整欄位範圍
# 進版控後，clone 者才會抽出一致的結果
!build/field_schema.json

# 系統檔案
Thumbs.db
desktop.ini
.DS_Store
